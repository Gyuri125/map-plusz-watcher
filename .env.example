# ============================================================
#  MÁP+ értesítő – helyi titkok
# ============================================================
#  1. Másold ezt a fájlt .env néven:
#         copy .env.example .env
#  2. Töltsd ki az értékeket.
#  3. A .env fájlt a .gitignore kizárja, sosem kerül a repóba.
#
#  GitHub Actions alatt nem .env kell, hanem repository secretök:
#  Settings -> Secrets and variables -> Actions -> New repository secret.
# ============================================================

# Discord webhook URL (kötelező, ha a Discord értesítés be van kapcsolva).
# Példa: https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=

# Telegram bot (kötelező, ha a Telegram értesítés be van kapcsolva).
# A bot tokent a @BotFather adja, a chat_id-t például a @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionális csatornák.
# Az ntfy téma nem titok, azt a config.toml-ban add meg; a token csak
# védett téma esetén kell.
NTFY_TOKEN=
SMTP_PASSWORD=
